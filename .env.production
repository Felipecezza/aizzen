# Configurações de ambiente de produção
NODE_ENV=production

# URLs do Supabase - substitua pelos valores corretos
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-publica-supabase

# URLs secundárias do Supabase (se necessário)
VITE_SUPABASE_SECONDARY_URL=https://seu-projeto-secundario.supabase.co
VITE_SUPABASE_SECONDARY_ANON_KEY=sua-chave-anonima-secundaria
VITE_SUPABASE_ADMIN_URL=https://seu-projeto-admin.supabase.co
VITE_SUPABASE_ADMIN_KEY=sua-chave-service-role

# URLs da API Webhook
VITE_WEBHOOK_BASE_URL=https://webhook.aizzen.com.br/webhook

# URLs do site
VITE_APP_URL=https://app.aizzen.com.br

# Configurações da aplicação
VITE_APP_NAME=AizzenV3
VITE_APP_DESCRIPTION=Plataforma de automação com IA 